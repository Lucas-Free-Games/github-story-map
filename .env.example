VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# GitHub default repo (per-user OAuth handled via Sign in with GitHub)
VITE_GITHUB_OWNER=Lucas-Free-Games
VITE_GITHUB_REPO=github-story-map

# Code with AI — Claude Managed Agents (optional)
# These IDs are non-secret and configured in the app's Settings tab; you can
# also seed defaults here. The Anthropic API key itself lives in Secret
# Manager (firebase functions:secrets:set ANTHROPIC_API_KEY) and never ships
# to the browser.
VITE_ANTHROPIC_AGENT_ID=agent_...
VITE_ANTHROPIC_ENV_ID=env_...
VITE_ANTHROPIC_VAULT_ID=vlt_...
